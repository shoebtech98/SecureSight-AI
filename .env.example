# Reference for environment variables. Set these in the backend process environment
# or in a project-root .env file, which backend/app/main.py loads on startup.
# Never commit credentials.
# Backend dependencies live in `backend/requirements.txt`.

# Environment name. "development" (the default) permits an insecure fallback
# SECRET_KEY with a warning. Set to "production" (or any non-dev value) to make
# a real SECRET_KEY mandatory — the app will refuse to start without one.
ENV=development

# JWT signing key. REQUIRED whenever ENV is not a development value.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Paste the Supabase Session pooler URI (port 5432) from Connect > ORMs.
# URL-encode special characters in the password. Keep this server-side only.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./securesight.db

# PostgreSQL in production: download the project CA certificate from Supabase
# Dashboard > Database Settings > SSL Configuration, then use verify-full.
# The certificate hostname must match the host in DATABASE_URL.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=C:/path/to/supabase-ca.crt

# Create a free API key in Google AI Studio. Never use VITE_ for this secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trust X-Forwarded-For for rate limiting only when every request passes
# through a trusted reverse proxy that sets/validates that header. The secure
# default is false, which prevents direct clients from evading throttling by
# spoofing the header.
TRUST_PROXY_HEADERS=false

# When serving Uvicorn directly, add --no-proxy-headers to its command.
# Only enable forwarded headers when a trusted reverse proxy is configured.
